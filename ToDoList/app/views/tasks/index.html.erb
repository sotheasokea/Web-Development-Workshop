<!-- Load Tailwind CSS via CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<!-- Outer Container -->
<div class="w-full max-w-sm sm:max-w-md md:max-w-lg mx-auto my-6 sm:my-12 px-4 sm:px-6">
  <%= turbo_frame_tag "tasks_frame" do %>
    <div class="bg-slate-800 rounded-2xl shadow-xl p-4 sm:p-6 border border-slate-700">
      
      <!-- Header & Item Counter -->
      <div class="flex items-center justify-between mb-4 sm:mb-6">
        <h1 class="text-lg sm:text-xl font-bold text-white tracking-wide">My Tasks</h1>
        <span class="text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 px-2.5 sm:px-3 py-1 rounded-full">
          <turbo-frame id="tasks_count">
            <%= @tasks.count %> <%= "item".pluralize(@tasks.count) %>
          </turbo-frame>
        </span>
      </div>

      <!-- Add Task Form -->
      <%= form_with(model: Task.new, id: "new_task_form", class: "flex flex-col sm:flex-row gap-2 mb-6") do |f| %>
        <%= f.text_field :title, 
            placeholder: "Add a new task...", 
            required: true, 
            class: "w-full flex-1 bg-slate-900/80 border border-slate-700 focus:border-indigo-500 rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition" %>
        <%= f.submit "Add Task", 
            class: "w-full sm:w-auto bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-md shadow-indigo-600/20 transition cursor-pointer text-center" %>
      <% end %>

      <!-- Dynamic Task List (Targeted by Turbo Stream) -->
      <ul id="tasks" class="space-y-3">
        <% if @tasks.any? %>
          <%= render @tasks %>
        <% else %>
          <li class="text-center py-6 text-slate-500 text-sm border border-dashed border-slate-700 rounded-xl">
            No tasks yet. Add one above!
          </li>
        <% end %>
      </ul>

    </div>
  <% end %>
</div>