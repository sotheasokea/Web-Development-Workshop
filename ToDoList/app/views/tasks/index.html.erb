<script src="https://cdn.tailwindcss.com"></script>

<div class="w-full max-w-sm sm:max-w-md md:max-w-lg mx-auto my-6 sm:my-12 px-4 sm:px-6">
  <%= turbo_frame_tag "tasks_frame" do %>
    <div class="bg-slate-600 rounded-2xl p-4 sm:p-6">
      
      <!-- Header & Item Counter -->
      <div class="flex items-center justify-between mb-4 sm:mb-6">
        <h1 class="text-lg sm:text-xl font-bold text-white tracking-wide">My ToDoList</h1>
        <span class="text-xs font-semibold bg-indigo-400 text-gray-900 border border-indigo-500/30 px-2.5 sm:px-3 py-1 rounded-full">
          <turbo-frame id="tasks_count">
            <%= Task.where(complete: [false, nil]).count %> pending
          </turbo-frame>
        </span>
      </div>

      <!-- Add Task Form -->
      <%= form_with(model: Task.new, id: "new_task_form", class: "flex flex-col sm:flex-row gap-2 mb-6") do |f| %>
        <%= f.text_field :title, 
            placeholder: "Add a new task...", 
            required: true, 
            class: "w-full flex-1 bg-slate-900/80 border border-slate-700 focus:border-black-500 rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition" %>
        <%= f.submit "Add Task", 
            class: "w-full sm:w-auto bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-md shadow-indigo-600/20 transition cursor-pointer text-center" %>
      <% end %>

      <!-- Pending Tasks Section -->
      <div class="mb-6">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Tasks</h2>
        <ul id="pending_tasks" class="space-y-3">
          <%= render @pending_tasks %>
        </ul>
      </div>

      <!-- Completed Tasks Section -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Completed</h2>
          <span class="text-xs font-semibold bg-emerald-500 text-gray-900 border border-emerald-500/30 px-2.5 py-0.5 rounded-full">
            <turbo-frame id="completed_tasks_count">
              <%= Task.where(complete: true).count %> completed
            </turbo-frame>
          </span>
        </div>
        
        <ul id="completed_tasks" class="space-y-3">
          <%= render @completed_tasks %>
        </ul>
      </div>

    </div>
  <% end %>
</div>

<!-- Styled Custom Modal -->
<dialog id="confirm-modal" class="fixed inset-0 z-50 m-0 flex items-center justify-center bg-transparent backdrop:bg-slate-950/70 p-0 rounded-2xl shadow-2xl backdrop:backdrop-blur-sm transition-all border-none">
  <div class="bg-slate-800 border border-slate-700 p-6 rounded-2xl max-w-sm w-full text-center space-y-4 shadow-2xl">
    <div class="w-12 h-12 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-full flex items-center justify-center mx-auto text-xl font-bold">
      !
    </div>
    <div class="space-y-1">
      <h3 class="text-base font-semibold text-white">Delete Task</h3>
      <p id="confirm-message" class="text-xs text-slate-400">Are you sure you want to delete this task?</p>
    </div>
    <div class="flex gap-2 justify-center pt-2">
      <button id="confirm-cancel" class="flex-1 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold py-2.5 rounded-xl transition cursor-pointer">
        Cancel
      </button>
      <button id="confirm-accept" class="flex-1 bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold py-2.5 rounded-xl transition cursor-pointer shadow-md shadow-rose-600/20">
        Delete
      </button>
    </div>
  </div>
</dialog>

<!-- Override Turbo's Default Confirm -->
<script>
  document.addEventListener("turbo:load", function() {
    if (typeof Turbo !== "undefined") {
      Turbo.setConfirmMethod((message, element) => {
        const dialog = document.getElementById("confirm-modal");
        const messageEl = document.getElementById("confirm-message");
        const confirmBtn = document.getElementById("confirm-accept");
        const cancelBtn = document.getElementById("confirm-cancel");

        dialog.style.position = "fixed";
        dialog.style.inset = "0";
        dialog.style.display = "flex";
        dialog.style.alignItems = "center";
        dialog.style.justifyContent = "center";
        dialog.style.margin = "0";

        if (message) messageEl.textContent = message;
        dialog.showModal();

        return new Promise((resolve) => {
          confirmBtn.onclick = () => {
            dialog.close();
            resolve(true);
          };

          cancelBtn.onclick = () => {
            dialog.close();
            resolve(false);
          };
        });
      });
    }
  });
</script>