<%# Replaces the specific task item with its updated state %>
<%= turbo_stream.replace dom_id(@task) do %>
  <%= render partial: "tasks/task", locals: { task: @task } %>
<% end %>

<%# Optional: Updates counter if needed %>
<%= turbo_stream.replace "tasks_count" do %>
  <turbo-frame id="tasks_count">
    <%= Task.count %> <%= "item".pluralize(Task.count) %>
  </turbo-frame>
<% end %>