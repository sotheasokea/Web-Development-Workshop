<%# 1. Remove task from current location %>
<%= turbo_stream.remove dom_id(@task) %>

<%# 2. Append task to its new section based on completion status %>
<% target_container = @task.complete? ? "completed_tasks" : "pending_tasks" %>
<%= turbo_stream.append target_container, partial: "tasks/task", locals: { task: @task } %>

<%# 3. Update pending count %>
<%= turbo_stream.replace "tasks_count" do %>
  <turbo-frame id="tasks_count">
    <%= Task.where(complete: [false, nil]).count %> pending
  </turbo-frame>
<% end %>

<%# 4. Update Completed Count %>
<%= turbo_stream.replace "completed_tasks_count" do %>
  <turbo-frame id="completed_tasks_count">
    <%= Task.where(complete: true).count %> completed
  </turbo-frame>
<% end %>