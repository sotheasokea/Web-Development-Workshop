<li id="<%= dom_id(task) %>" class="flex items-center justify-between bg-slate-900/60 hover:bg-slate-900/90 rounded-xl px-3.5 sm:px-4 py-3 border border-slate-700/80 transition group gap-3">
  <div class="flex items-center gap-3 min-w-0 flex-1 group/item">
    <%= form_with(model: task, method: :patch) do |f| %>
      <%= f.check_box :complete, 
          onchange: "this.form.requestSubmit()", 
          class: "h-5 w-5 shrink-0 accent-indigo-500 rounded border-slate-600 focus:ring-0 focus:ring-offset-0 cursor-pointer" %>
    <% end %>
    
    <div class="flex flex-col min-w-0 flex-1">
      <span class="text-sm font-medium truncate group-has-[:checked]/item:line-through group-has-[:checked]/item:text-slate-500 <%= task.complete ? 'line-through text-slate-500' : 'text-slate-200' %>">
        <%= task.title %>
      </span>
      
      <!-- Timestamp Display -->
      <span class="text-[10px] text-slate-500 mt-0.5">
        Added <%= time_ago_in_words(task.created_at) %> ago
      </span>
    </div>
  </div>

  <%= button_to task_path(task), 
      method: :delete, 
      class: "text-slate-500 hover:text-red-400 opacity-100 sm:opacity-60 sm:group-hover:opacity-100 text-xs font-bold transition p-1.5 shrink-0", 
      form: { data: { turbo_confirm: "Are you sure you want to delete this task?" } } do %>
    ✕
  <% end %>
</li>